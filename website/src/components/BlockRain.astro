<canvas id="rain" aria-hidden="true"></canvas>

<style>
  canvas { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 0; pointer-events: none; }
</style>

<script>
  import { COLORS, KEYS, normalized } from '../data/pieces';

  const cv = document.getElementById('rain') as HTMLCanvasElement;
  const ctx = cv.getContext('2d')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let W = 0, H = 0, dpr = 1;

  type P = { k: (typeof KEYS)[number]; x: number; y: number; z: number; vy: number; rot: number; vr: number; a: number };
  let parts: P[] = [];
  let scroll = 0;

  const spawn = (initial = false): P => {
    const z = Math.random();               // 0 far … 1 near
    return {
      k: KEYS[(Math.random() * KEYS.length) | 0],
      x: Math.random() * W, y: initial ? Math.random() * H : -120,
      z, vy: 14 + z * 46, rot: Math.random() * Math.PI * 2, vr: (Math.random() - 0.5) * 0.6, a: 0,
    };
  };

  const resize = () => {
    dpr = Math.min(devicePixelRatio || 1, 2);
    W = innerWidth; H = innerHeight;
    cv.width = W * dpr; cv.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const n = Math.round(Math.min(34, Math.max(14, W / 46)));
    parts = Array.from({ length: n }, () => spawn(true));
  };

  const drawPiece = (p: P) => {
    const s = 10 + p.z * 26;
    const { cells, w, h } = normalized(p.k);
    ctx.save();
    ctx.translate(p.x, p.y - scroll * (0.05 + p.z * 0.25));
    ctx.rotate(p.rot);
    ctx.globalAlpha = 0.07 + p.z * 0.2;
    ctx.fillStyle = COLORS[p.k];
    ctx.shadowColor = COLORS[p.k]; ctx.shadowBlur = p.z > 0.7 ? 18 : 0;
    for (const [cx, cy] of cells) {
      const x = (cx - w / 2) * s, y = (cy - h / 2) * s;
      ctx.beginPath(); ctx.roundRect(x + 1, y + 1, s - 2, s - 2, s * 0.22); ctx.fill();
    }
    ctx.shadowBlur = 0;
    ctx.fillStyle = '#fff'; ctx.globalAlpha *= 0.35;
    for (const [cx, cy] of cells) {
      const x = (cx - w / 2) * s, y = (cy - h / 2) * s;
      ctx.beginPath(); ctx.roundRect(x + s * 0.14, y + s * 0.1, s * 0.72, s * 0.2, s * 0.1); ctx.fill();
    }
    ctx.restore();
  };

  let last = performance.now();
  const frame = (now: number) => {
    const dt = Math.min(0.05, (now - last) / 1000); last = now;
    ctx.clearRect(0, 0, W, H);
    for (const p of parts) {
      if (!reduce) { p.y += p.vy * dt; p.rot += p.vr * dt; }
      if (p.y > H + 160) Object.assign(p, spawn());
    }
    parts.sort((a, b) => a.z - b.z).forEach(drawPiece);
    requestAnimationFrame(frame);
  };

  addEventListener('resize', resize);
  addEventListener('scroll', () => (scroll = scrollY), { passive: true });
  resize();
  requestAnimationFrame(frame);
</script>
