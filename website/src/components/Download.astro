---
import Piece from './Piece.astro';
---
<section class="get wrap" id="get">
  <div class="card reveal">
    <div class="art" aria-hidden="true">
      <Piece type="T" size={44} class="p1" />
      <Piece type="O" size={36} class="p2" />
      <Piece type="I" size={30} class="p3" />
    </div>
    <p class="eyebrow">Ready when you are</p>
    <h2 class="h2">One more <em>line.</em></h2>
    <p class="lede">Grab the latest Android build from GitHub, or clone the Godot 4.5 project and run it yourself.</p>
    <div class="cta">
      <a class="btn" href="https://github.com/faisalsaifii/blocklin/releases" target="_blank" rel="noopener">Download for Android</a>
      <a class="btn ghost" href="https://github.com/faisalsaifii/blocklin" target="_blank" rel="noopener">View on GitHub</a>
    </div>
  </div>
</section>
<footer class="foot">
  <div class="wrap"><span>Blocklin</span><span>Made with Godot 4.5 · Stack responsibly.</span></div>
  <div class="stack" aria-hidden="true">{Array.from({ length: 36 }).map((_, i) => <i class="blk" style={`--i:${i};--h:${(i * 53) % 360}`}></i>)}</div>
</footer>

<style>
  .get { padding: 100px 0 80px; position: relative; z-index: 2; }
  .card {
    position: relative; overflow: hidden; text-align: center; padding: clamp(50px, 9vw, 110px) 24px; border-radius: 44px;
    background: radial-gradient(120% 120% at 50% 0%, rgba(255, 107, 203, .28), transparent 60%), linear-gradient(160deg, rgba(255, 255, 255, .1), rgba(255, 255, 255, .02));
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, .14), 0 0 120px -30px var(--pink);
  }
  .lede { margin-inline: auto; }
  .cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin-top: 38px; }
  .art :global(.piece) { position: absolute; opacity: .9; filter: drop-shadow(0 0 20px rgba(255, 255, 255, .25)); }
  .art :global(.p1) { left: 6%; top: 12%; rotate: -16deg; animation: fl 7s ease-in-out infinite; }
  .art :global(.p2) { right: 8%; top: 18%; rotate: 12deg; animation: fl 8s -2s ease-in-out infinite; }
  .art :global(.p3) { right: 16%; bottom: 10%; rotate: 78deg; animation: fl 6s -4s ease-in-out infinite; }
  @keyframes fl { 50% { translate: 0 -18px; } }

  .foot { position: relative; z-index: 2; padding-top: 30px; }
  .foot .wrap { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--dim); font-weight: 700; padding-bottom: 20px; }
  .foot .wrap span:first-child { font-family: var(--display); color: #fff; letter-spacing: .06em; font-size: 16px; }
  .stack { display: grid; grid-template-columns: repeat(36, 1fr); }
  .stack i { --c: hsl(var(--h) 62% 66%); aspect-ratio: 1; border-radius: 0; animation: settle 4s calc(var(--i) * 70ms) ease-in-out infinite alternate; }
  .stack i::before { display: none; }
  @keyframes settle { from { translate: 0 30%; opacity: .5; } to { translate: 0 0; opacity: 1; } }
</style>
