---
import Piece from './Piece.astro';
const words = ['LINE CLEAR', 'COMBO', 'SLAM', 'CHAIN IT', 'STACK HIGH', 'SPIN', 'BLOCKLIN!'];
const kinds = ['T', 'L', 'I', 'S', 'O', 'Z', 'J'] as const;
---
<div class="band" aria-hidden="true">
  <div class="track">
    {[0, 1].map(() => (
      <div class="set">
        {words.map((w, i) => (<><span>{w}</span><Piece type={kinds[i]} size={9} /></>))}
      </div>
    ))}
  </div>
</div>

<style>
  .band { position: relative; z-index: 2; margin: -10px 0 40px; rotate: -2.2deg; scale: 1.05; background: linear-gradient(90deg, var(--pink), #7b3fe4 50%, var(--cyan)); padding: 16px 0; box-shadow: 0 0 60px rgba(255, 107, 203, .45); overflow: hidden; }
  .track { display: flex; width: max-content; animation: slide 28s linear infinite; }
  .set { display: flex; align-items: center; gap: 34px; padding-right: 34px; white-space: nowrap; }
  .set span { font-family: var(--display); font-size: 26px; color: #fff; letter-spacing: .06em; text-shadow: 0 3px 0 rgba(0, 0, 0, .25); }
  @keyframes slide { to { transform: translateX(-50%); } }
</style>
