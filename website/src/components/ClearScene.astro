---
import { COLORS } from '../data/pieces';
const palette = Object.values(COLORS);
const rnd = (n: number) => { const x = Math.sin(n * 12.9898) * 43758.5453; return x - Math.floor(x); };
// [col,row] — row 3 is the bottom row with a 4-wide gap at cols 4-7
const base: [number, number][] = [];
for (let x = 0; x < 12; x++) if (x < 4 || x > 7) base.push([x, 3]);
[0, 1, 2, 9, 10, 11].forEach((x) => base.push([x, 2]));
[0, 1, 11].forEach((x) => base.push([x, 1]));
const blocks = base.map(([x, y], i) => ({
  x, y, col: palette[(x * 3 + y * 5 + i) % 7],
  fx: Math.round((rnd(i) - 0.5) * 600), fy: Math.round(-120 - rnd(i + 9) * 320), fr: Math.round((rnd(i + 3) - 0.5) * 720),
}));
const piece = [4, 5, 6, 7].map((x, i) => ({ x, fx: Math.round((rnd(i + 40) - 0.5) * 500), fy: Math.round(-160 - rnd(i + 50) * 260), fr: Math.round((rnd(i + 60) - 0.5) * 720) }));
---
<section class="scene" id="clear">
  <div class="sticky">
    <div class="wrap grid">
      <div class="words">
        <p class="eyebrow">The payoff</p>
        <h2 class="h2">Fill the gap.<br /><em>Watch it go.</em></h2>
        <p class="lede">That tiny hush before a line clears, the flash, the scatter. Keep scrolling and drop the piece.</p>
        <div class="ticker"><span class="a">Drop it…</span><span class="b">+100 <em>SINGLE</em></span></div>
      </div>

      <div class="field" id="field">
        <div class="board">
          {blocks.map((b) => (
            <i class={`blk r${b.y}`} style={`--c:${b.col};left:calc(var(--u)*${b.x});top:calc(var(--u)*${b.y});--fx:${b.fx}px;--fy:${b.fy}px;--fr:${b.fr}deg`}></i>
          ))}
          {piece.map((p) => (
            <i class="blk r3 drop" style={`--c:${COLORS.I};left:calc(var(--u)*${p.x});--fx:${p.fx}px;--fy:${p.fy}px;--fr:${p.fr}deg`}></i>
          ))}
          <span class="ghost"></span>
          <span class="flash"></span>
        </div>
        <div class="floorline"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .scene { position: relative; z-index: 2; height: 320vh; margin-top: 60px; }
  .sticky { position: sticky; top: 0; height: 100vh; display: flex; align-items: center; overflow: hidden; }
  .grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 40px; align-items: center; }
  .words .lede { margin-top: 20px; }
  .ticker { position: relative; height: 56px; margin-top: 30px; font-family: var(--display); font-size: 28px; }
  .ticker span { position: absolute; left: 0; top: 0; transition: opacity .4s, transform .5s cubic-bezier(.3, 1.8, .4, 1); }
  .ticker .a { color: var(--dim); }
  .ticker .b { opacity: 0; transform: translateY(20px) scale(.7); transform-origin: left; color: #fff; text-shadow: 0 0 24px var(--pink); }
  .ticker em { font-style: normal; color: var(--cyan); margin-left: 8px; }
  .scene.cleared .a { opacity: 0; }
  .scene.cleared .b { opacity: 1; transform: none; }

  .field { --u: min(6.2vw, 62px); position: relative; justify-self: center; }
  .board { position: relative; width: calc(var(--u) * 12); height: calc(var(--u) * 4); }
  .board .blk { position: absolute; width: var(--u); height: var(--u); transform: scale(.94); transition: transform .9s cubic-bezier(.2, .8, .2, 1), opacity .7s; }
  .floorline { height: 4px; margin-top: 4px; border-radius: 4px; background: linear-gradient(90deg, var(--cyan), var(--pink)); box-shadow: 0 0 24px var(--pink); }
  .drop { top: calc(var(--u) * 3); translate: 0 calc(var(--u) * var(--py, -5)); transition: none !important; }
  .ghost { position: absolute; left: calc(var(--u) * 4); top: calc(var(--u) * 3); width: calc(var(--u) * 4); height: var(--u); border-radius: 12px; box-shadow: inset 0 0 0 2px rgba(94, 231, 255, .6); background: rgba(94, 231, 255, .1); animation: ghost 1.4s ease-in-out infinite; transition: opacity .3s; }
  @keyframes ghost { 50% { opacity: .35; } }
  .scene.landed .ghost, .scene.cleared .ghost { opacity: 0 !important; animation: none; }

  .flash { position: absolute; left: -4%; right: -4%; top: calc(var(--u) * 3); height: var(--u); background: #fff; opacity: 0; pointer-events: none; box-shadow: 0 0 80px 30px rgba(94, 231, 255, .7); }
  .scene.cleared .flash { animation: flash .7s ease-out; }
  @keyframes flash { 0% { opacity: 1; } 100% { opacity: 0; } }

  /* the clear: bottom row scatters, rows above fall one cell */
  .scene.cleared .r3 { transform: translate(var(--fx), var(--fy)) rotate(var(--fr)) scale(.2); opacity: 0; }
  .scene.cleared .r2, .scene.cleared .r1 { transform: translateY(var(--u)) scale(.94); transition-delay: .25s; }

  @media (max-width: 880px) { .grid { grid-template-columns: 1fr; gap: 20px; } .field { --u: 6.6vw; } .scene { height: 280vh; } }
</style>

<script>
  const scene = document.getElementById('clear')!;
  const pieces = [...scene.querySelectorAll<HTMLElement>('.drop')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ease = (t: number) => 1 - (1 - t) ** 3;
  const update = () => {
    const r = scene.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, -r.top / (r.height - innerHeight)));
    const fall = reduce ? 1 : ease(Math.min(1, p / 0.5));
    pieces.forEach((el) => el.style.setProperty('--py', String(-5 * (1 - fall))));
    scene.classList.toggle('landed', fall > 0.98);
    scene.classList.toggle('cleared', p > 0.58);
  };
  addEventListener('scroll', update, { passive: true });
  addEventListener('resize', update);
  update();
</script>
