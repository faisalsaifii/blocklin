---
import Layout from '../layouts/Layout.astro';
import BlockRain from '../components/BlockRain.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Pieces from '../components/Pieces.astro';
import Feel from '../components/Feel.astro';
import ClearScene from '../components/ClearScene.astro';
import Download from '../components/Download.astro';
---
<Layout title="Blocklin: neon block-stacking" description="Blocklin is a glossy synthwave falling-block puzzler for mobile. Swipe, slam and chain line clears into big combos.">
  <BlockRain />
  <main>
    <Hero />
    <Marquee />
    <Pieces />
    <Feel />
    <ClearScene />
    <Download />
  </main>
</Layout>
